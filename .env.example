# Copy this file to `.env` and put your real key in it:
#
#     cp .env.example .env
#
# `.env` is gitignored. This file (`.env.example`) is committed and must never
# contain a real key -- it exists so you know what to fill in.
#
# Get a key at https://console.anthropic.com -> API Keys.

ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME

# Optional. Only needed if you add FRED macro series; the current pipeline does
# not use it.
# FRED_API_KEY=
